@page
@model SignUpModel
@{
    ViewData["Title"] = L.T("Create account");
    ViewData["AppShell"] = false;
}
<div class="auth-shell">
    <div class="auth-brand-panel">
        <div class="brand"><span class="brand-mark"><svg class="icon" style="stroke:#fff"><use href="#i-briefcase"></use></svg></span><div>@L.T("Munaqasat")</div></div>
        <div class="auth-quote">@L.T("“Setting up our company profile took ten minutes — our first accepted bid came the same week.”")<small>@L.T("— Founder, Al Nahda Consulting Group")</small></div>
        <div class="auth-trust"><div><strong>@L.T("2 min")</strong><span>@L.T("Avg. setup")</span></div><div><strong>@L.T("Free")</strong><span>@L.T("To get started")</span></div><div><strong>@L.T("EN / AR")</strong><span>@L.T("Full support")</span></div></div>
    </div>
    <div class="auth-form-panel">
        <div class="auth-form-box">
            <div class="step-indicator">
                <span class="step-dot is-active" id="su-dot-1">1</span><span class="step-line"></span><span class="step-dot" id="su-dot-2">2</span>
                <span style="margin-inline-start:8px;text-transform:none;font-weight:600;color:var(--ink-soft)" id="su-step-label">@L.T("Choose your account type")</span>
            </div>

            <form method="post">
                <input type="hidden" id="accountType" name="accountType" value="" />

                <div id="su-step1">
                    <h1>@L.T("Create your account")</h1>
                    <p class="sub">@L.T("Tell us how you'll use Munaqasat — this sets up the right tools for you.")</p>
                    <div class="role-pick-grid">
                        <div class="role-pick" id="pick-client" onclick="selectAccountType('client')">
                            <span class="ico"><svg class="icon"><use href="#i-building"></use></svg></span>
                            <div><h4>@L.T("I represent an organization")</h4><p>@L.T("Post tenders and review requests from contractors and suppliers.")</p></div>
                        </div>
                        <div class="role-pick" id="pick-contractor" onclick="selectAccountType('contractor')">
                            <span class="ico"><svg class="icon"><use href="#i-briefcase"></use></svg></span>
                            <div><h4>@L.T("I provide services or supplies")</h4><p>@L.T("Browse open tenders and submit competitive bids.")</p></div>
                        </div>
                        <div class="role-pick" id="pick-individual" onclick="selectAccountType('individual')">
                            <span class="ico"><svg class="icon"><use href="#i-user"></use></svg></span>
                            <div><h4>@L.T("I'm just browsing")</h4><p>@L.T("Follow tenders and save the ones you're interested in — no company required.")</p></div>
                        </div>
                    </div>
                    <button type="button" class="btn btn-primary btn-block" style="margin-top:20px" id="su-continue" disabled onclick="goSignupStep2()">@L.T("Continue")</button>
                </div>

                <div id="su-step2" hidden class="field-stack">
                    <div class="field-row" id="su-step2-names">
                        <div class="field"><label class="field-label" for="suName">@L.T("Full name")</label><input id="suName" name="fullName" type="text" placeholder="@L.T("Ahmed Al Rawahi")" required></div>
                        <div class="field" id="suOrgField"><label class="field-label" for="suOrg" id="suOrgLabel">@L.T("Company name")</label><input id="suOrg" name="orgName" type="text" placeholder="@L.T("Gulf Systems Integration LLC")" required></div>
                    </div>
                    <div class="field"><label class="field-label" for="suEmail" id="suEmailLabel">@L.T("Work email")</label><input id="suEmail" name="email" type="email" placeholder="you@company.om" required></div>
                    <div class="field-row">
                        <div class="field"><label class="field-label" for="suPhone">@L.T("Phone")</label><input id="suPhone" name="phone" type="tel" placeholder="@L.T("+968 9xxx xxxx")"></div>
                        <div class="field"><label class="field-label" for="suPass">@L.T("Password")</label><input id="suPass" name="password" type="password" placeholder="@L.T("••••••••")" required></div>
                    </div>
                    <label class="checkbox-row"><input type="checkbox" required> @L.T("I agree to the Terms of Service and Privacy Policy")</label>
                    <div class="form-actions-group">
                        <button type="button" class="btn btn-secondary" onclick="goSignupStep1()">@L.T("Back")</button>
                        <button class="btn btn-primary btn-block" type="submit">@L.T("Create account")</button>
                    </div>
                </div>
            </form>
            <p class="auth-switch">@L.T("Already have an account?") <a href="/Account/SignIn">@L.T("Sign in")</a></p>
        </div>
    </div>
</div>
