@page
@model IndexModel
@{
    ViewData["Title"] = L.T("Admin console");
    ViewData["AppShell"] = true;
    ViewData["ActiveNav"] = "admin";
}

<div class="page-head"><div><h1>@L.T("Admin console")</h1><p class="sub">@L.T("Platform-wide oversight of tenders, companies and requests.")</p></div></div>
<div class="tabs">
    <div class="tab is-active" data-tab-group="admin" data-tab-value="dashboard">@L.T("Dashboard")</div>
    <div class="tab" data-tab-group="admin" data-tab-value="tenders">@L.T("Tenders")</div>
    <div class="tab" data-tab-group="admin" data-tab-value="companies">@L.T("Companies")</div>
    <div class="tab" data-tab-group="admin" data-tab-value="users">@L.T("Users")</div>
    <div class="tab" data-tab-group="admin" data-tab-value="requests">@L.T("Requests")</div>
</div>

<div data-tab-panel="admin" data-tab-value="dashboard">
    <div class="stat-grid">
        <div class="stat-tile"><div class="top"><span class="ico" style="background:var(--accent-soft);color:var(--accent-ink)"><svg class="icon"><use href="#i-grid"></use></svg></span></div><strong>@Model.Tenders.Count.ToString("N0")</strong><span class="label">@L.T("Total tenders")</span></div>
        <div class="stat-tile"><div class="top"><span class="ico" style="background:var(--green-soft);color:var(--green)"><svg class="icon"><use href="#i-check"></use></svg></span></div><strong>@Model.OpenTenderCount.ToString("N0")</strong><span class="label">@L.T("Open tenders")</span></div>
        <div class="stat-tile"><div class="top"><span class="ico" style="background:var(--blue-soft);color:var(--blue)"><svg class="icon"><use href="#i-users"></use></svg></span></div><strong>@Model.Companies.Count.ToString("N0")</strong><span class="label">@L.T("Registered companies")</span></div>
        <div class="stat-tile"><div class="top"><span class="ico" style="background:var(--orange-soft);color:var(--orange)"><svg class="icon"><use href="#i-clock"></use></svg></span></div><strong>@Model.PendingRequests.Count.ToString("N0")</strong><span class="label">@L.T("Pending requests")</span></div>
    </div>
    <h3 style="font-size:14px;margin-bottom:12px">@L.T("Recently published tenders")</h3>
    <div class="table-wrap" style="margin-bottom:26px">
        <table>
            <thead><tr><th>@L.T("Tender")</th><th>@L.T("Category")</th><th>@L.T("Closing")</th><th>@L.T("Status")</th></tr></thead>
            <tbody>
                @foreach (var t in Model.Tenders.Take(4))
                {
                    <tr>
                        <td class="cell-primary">@t.Title<div class="cell-sub">@t.TenderNo</div></td>
                        <td><span class="tag @t.CategoryTagClass">@t.CategoryLabel</span></td>
                        <td>@t.Closing.ToString("d MMM yyyy")</td>
                        <td><span class="pill-status @t.StatusClass">@L.T(t.Status)</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <h3 style="font-size:14px;margin-bottom:12px">@L.T("Requests awaiting review")</h3>
    <form id="adminToken" hidden>@Html.AntiForgeryToken()</form>
    <div class="table-wrap">
        <table>
            <thead><tr><th>@L.T("Company")</th><th>@L.T("Tender")</th><th>@L.T("Price (OMR)")</th><th>@L.T("Status")</th><th></th></tr></thead>
            <tbody>
                @foreach (var r in Model.PendingRequests)
                {
                    var t = Model.Tenders.FirstOrDefault(x => x.Id == r.TenderId);
                    <tr data-request-id="@r.Id">
                        <td class="cell-primary">@r.Company</td>
                        <td>@if (t is not null) { <a href="/Tenders/Details/@t.Id">@t.Title</a> }</td>
                        <td class="mono">@r.Price.ToString("N0")</td>
                        <td><span class="pill-status @r.StatusClass">@L.T(r.Status)</span></td>
                        <td class="row-actions">
                            <button type="button" class="btn btn-ghost btn-sm" onclick="adminSetStatus(this,'ACCEPTED')">@L.T("Accept")</button>
                            <button type="button" class="btn btn-danger-ghost btn-sm" onclick="adminSetStatus(this,'REJECTED')">@L.T("Reject")</button>
                        </td>
                    </tr>
                }
                @if (!Model.PendingRequests.Any())
                {
                    <tr><td colspan="5" style="text-align:center;color:var(--ink-faint);padding:22px">@L.T("No requests are waiting for review.")</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div data-tab-panel="admin" data-tab-value="tenders" hidden>
    <div class="row-between" style="margin-bottom:14px">
        <span class="results-count">@L.T("{0} tenders", Model.Tenders.Count)</span>
        <a class="btn btn-primary btn-sm" href="/Tenders/Create"><svg class="icon" style="width:15px;height:15px"><use href="#i-plus"></use></svg> @L.T("New tender")</a>
    </div>
    <div class="table-wrap">
        <table>
            <thead><tr><th>@L.T("Tender")</th><th>@L.T("Entity")</th><th>@L.T("Category")</th><th>@L.T("Closing")</th><th>@L.T("Status")</th><th></th></tr></thead>
            <tbody>
                @foreach (var t in Model.Tenders)
                {
                    <tr>
                        <td class="cell-primary">@t.Title<div class="cell-sub mono">@t.TenderNo</div></td>
                        <td>@t.Entity</td>
                        <td><span class="tag @t.CategoryTagClass">@t.CategoryLabel</span></td>
                        <td>@t.Closing.ToString("d MMM yyyy")</td>
                        <td><span class="pill-status @t.StatusClass">@L.T(t.Status)</span></td>
                        <td class="row-actions">
                            <a class="icon-btn btn-icon" href="/Tenders/Details/@t.Id" title="@L.T("Open tender")" aria-label="Open @t.Title"><svg class="icon" style="width:15px;height:15px"><use href="#i-chevron-right"></use></svg></a>
                        </td>
                    </tr>
                }
                @if (!Model.Tenders.Any())
                {
                    <tr><td colspan="6" style="text-align:center;color:var(--ink-faint);padding:22px">@L.T("No tenders yet.")</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div data-tab-panel="admin" data-tab-value="companies" hidden>
    <div class="table-wrap">
        <table>
            <thead><tr><th>@L.T("Company")</th><th>@L.T("Sectors")</th><th>@L.T("Rating")</th><th>@L.T("Ratings count")</th><th>@L.T("Status")</th><th></th></tr></thead>
            <tbody>
                @foreach (var c in Model.Companies)
                {
                    <tr>
                        <td class="cell-primary">@c.Name</td>
                        <td>@string.Join(L.IsRtl ? "، " : ", ", c.Sectors.Split(", ", StringSplitOptions.RemoveEmptyEntries).Select(x => L.T(x)))</td>
                        <td class="mono">@c.Rating.ToString("0.0")</td>
                        <td>@c.Count</td>
                        <td><span class="pill-status @(c.Status == "Verified" ? "status-open" : "status-pending")">@L.T(c.Status)</span></td>
                        <td class="row-actions"><a class="btn btn-ghost btn-sm" href="/Companies/Profile/@c.Id">@L.T("View")</a></td>
                    </tr>
                }
                @if (!Model.Companies.Any())
                {
                    <tr><td colspan="6" style="text-align:center;color:var(--ink-faint);padding:22px">@L.T("No companies yet.")</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div data-tab-panel="admin" data-tab-value="users" hidden>
    <div class="table-wrap">
        <table>
            <thead><tr><th>@L.T("Name")</th><th>@L.T("Email")</th><th>@L.T("Role")</th><th>@L.T("Company")</th><th>@L.T("Joined")</th></tr></thead>
            <tbody>
                @foreach (var u in Model.Users)
                {
                    <tr>
                        <td class="cell-primary">@u.Name</td>
                        <td>@u.Email</td>
                        <td><span class="tag tag-neutral">@L.T(u.Role)</span></td>
                        <td>@u.Company</td>
                        <td>@u.Joined.ToString("d MMM yyyy")</td>
                    </tr>
                }
                @if (!Model.Users.Any())
                {
                    <tr><td colspan="5" style="text-align:center;color:var(--ink-faint);padding:22px">@L.T("No users yet.")</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div data-tab-panel="admin" data-tab-value="requests" hidden>
    <div class="table-wrap">
        <table>
            <thead><tr><th>@L.T("Company")</th><th>@L.T("Tender")</th><th>@L.T("Price (OMR)")</th><th>@L.T("Days")</th><th>@L.T("Status")</th></tr></thead>
            <tbody>
                @foreach (var r in Model.Requests)
                {
                    var t = Model.Tenders.FirstOrDefault(x => x.Id == r.TenderId);
                    <tr data-request-id="@r.Id">
                        <td class="cell-primary">@r.Company</td>
                        <td>@if (t is not null) { <a href="/Tenders/Details/@t.Id">@t.Title</a> }</td>
                        <td class="mono">@r.Price.ToString("N0")</td>
                        <td>@r.Days</td>
                        <td><span class="pill-status @r.StatusClass">@L.T(r.Status)</span></td>
                    </tr>
                }
                @if (!Model.Requests.Any())
                {
                    <tr><td colspan="5" style="text-align:center;color:var(--ink-faint);padding:22px">@L.T("No requests yet.")</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
