@page
@model ErrorModel
@{
    ViewData["Title"] = L.T("Error");
}

<main class="m-main" style="padding-block:60px">
    <h1>@L.T("Something went wrong")</h1>
    <p class="sub">@L.T("An error occurred while processing your request.")</p>
    @if (Model.ShowRequestId)
    {
        <p><strong>@L.T("Request ID:")</strong> <code dir="ltr">@Model.RequestId</code></p>
    }
    <a class="btn btn-primary" href="/">@L.T("Back to home")</a>
</main>
