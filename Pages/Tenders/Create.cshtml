@page
@model CreateModel
@{
    ViewData["Title"] = L.T("Post a tender");
    ViewData["AppShell"] = true;
    ViewData["ActiveNav"] = "tender-form";
}

<div class="page-head"><div><h1>@L.T("Post a tender")</h1><p class="sub">@L.T("Fields marked with the language tabs support both English and Arabic.")</p></div></div>

<form method="post">
    <div class="form-card">
        <h2>@L.T("Basic information")</h2><p class="desc">@L.T("What the tender is, and who is issuing it.")</p>
        <div class="lang-tabs">
            <button type="button" class="cs-tab-btn is-active" id="tf-lang-en" onclick="setFormLang('en')">@L.T("English")</button>
            <button type="button" class="cs-tab-btn" id="tf-lang-ar" onclick="setFormLang('ar')">العربية</button>
        </div>
        <div class="field-stack">
            <div class="field-row">
                <div class="field"><label class="field-label" for="tfEntity">@L.T("Issuing entity")</label><input id="tfEntity" name="Entity" type="text" placeholder="@L.T("Ministry of Transport, Communications and IT")"></div>
                <div class="field"><label class="field-label" for="tfTitle">@L.T("Tender title")</label><input id="tfTitle" name="Title" type="text" placeholder="@L.T("Supply and installation of network equipment")"></div>
            </div>
            <div class="field-row">
                <div class="field"><label class="field-label" for="tfNo">@L.T("Tender no.")</label><input id="tfNo" name="TenderNo" class="mono" type="text" placeholder="@L.T("112/2026/MTCIT/DGIT-14")"></div>
                <div class="field"><label class="field-label" for="tfExtId">@L.T("External tender ID")</label><input id="tfExtId" name="ExtId" class="mono" type="text" placeholder="98629"></div>
            </div>
            <div class="field-row">
                <div class="field"><label class="field-label" for="tfCategory">@L.T("Procurement category")</label><select id="tfCategory" name="Category"><option value="Supply">@L.T("Supply")</option><option value="Services">@L.T("Services")</option><option value="Works">@L.T("Works")</option></select></div>
                <div class="field"><label class="field-label" for="tfType">@L.T("Tender type")</label><select id="tfType" name="TenderType"><option value="Open — local">@L.T("Open — local")</option><option value="Open — international">@L.T("Open — international")</option><option value="Limited">@L.T("Limited")</option></select></div>
            </div>
            <div class="field-row">
                <div class="field"><label class="field-label" for="tfGov">@L.T("Governorate")</label><select id="tfGov" name="Governorate"><option value="Muscat">@L.T("Muscat")</option><option value="Al Wusta">@L.T("Al Wusta")</option><option value="North Sharqiyah">@L.T("North Sharqiyah")</option><option value="Al Batinah North">@L.T("Al Batinah North")</option></select></div>
                <div class="field"><label class="field-label" for="tfWilayat">@L.T("Wilayat")</label><input id="tfWilayat" name="Wilayat" type="text" placeholder="@L.T("Bawshar")"></div>
            </div>
            <label class="checkbox-row"><input type="checkbox" name="AlternateBids" value="true"> @L.T("Alternate bids allowed")</label>
        </div>
    </div>

    <div class="form-card">
        <h2>@L.T("Key dates")</h2><p class="desc">@L.T("All times are Asia/Muscat (GMT+4).")</p>
        <div class="field-stack">
            <div class="field-row">
                <div class="field"><label class="field-label" for="tfPub">@L.T("Published date")</label><input id="tfPub" name="Published" type="date"></div>
                <div class="field"><label class="field-label" for="tfSaleStart">@L.T("Document sale — start")</label><input id="tfSaleStart" name="SaleStart" type="datetime-local"></div>
                <div class="field"><label class="field-label" for="tfSaleEnd">@L.T("Document sale — end")</label><input id="tfSaleEnd" name="SaleEnd" type="datetime-local"></div>
            </div>
            <div class="field-row">
                <div class="field"><label class="field-label" for="tfClarStart">@L.T("Prebid clarification — start")</label><input id="tfClarStart" name="ClarStart" type="datetime-local"></div>
                <div class="field"><label class="field-label" for="tfClarEnd">@L.T("Prebid clarification — end")</label><input id="tfClarEnd" name="ClarEnd" type="datetime-local"></div>
            </div>
            <div class="field-row">
                <div class="field"><label class="field-label" for="tfClosing">@L.T("Bid submission closing")</label><input id="tfClosing" name="Closing" type="datetime-local"></div>
                <div class="field"><label class="field-label" for="tfOpening">@L.T("Priced bid opening")</label><input id="tfOpening" name="Opening" type="datetime-local"></div>
            </div>
        </div>
    </div>

    <div class="form-card">
        <h2>@L.T("Financial terms")</h2><p class="desc">@L.T("Document fee and bid bond requirements.")</p>
        <div class="field-stack">
            <div class="field-row">
                <div class="field"><label class="field-label" for="tfFee">@L.T("Document fee (OMR)")</label><input id="tfFee" name="DocFee" type="number" step="0.001" placeholder="25.000"></div>
                <div class="field"><label class="field-label" for="tfFeeMode">@L.T("Payment mode")</label><select id="tfFeeMode" name="FeeMode"><option value="Online payment">@L.T("Online payment")</option><option value="Bank transfer">@L.T("Bank transfer")</option><option value="Cash at office">@L.T("Cash at office")</option></select></div>
                <div class="field"><label class="field-label" for="tfBond">@L.T("Bid bond (%)")</label><input id="tfBond" name="Bond" type="number" step="0.1" placeholder="2.0"></div>
            </div>
            <label class="checkbox-row"><input type="checkbox" name="EBond" value="true"> @L.T("e-Bond accepted")</label>
        </div>
    </div>

    <div class="form-card">
        <h2>@L.T("Description & requirements")</h2><p class="desc">@L.T("A short note plus any additional requirements bidders should see.")</p>
        <div class="field" style="margin-bottom:20px"><label class="field-label" for="tfDesc">@L.T("Description")</label><textarea id="tfDesc" name="Description" placeholder="@L.T("Scope of work, delivery expectations, site conditions…")"></textarea></div>
        <div id="tf-customfields">
            <div class="cf-row">
                <div class="field"><label class="field-label">@L.T("Title")</label><input type="text" name="CustomFields[0].Title" placeholder="@L.T("e.g. Warranty period")"></div>
                <div class="field"><label class="field-label">@L.T("Description")</label><input type="text" name="CustomFields[0].Description" placeholder="@L.T("e.g. Minimum 3 years onsite warranty")"></div>
                <button type="button" class="icon-btn btn-icon remove-row-btn" onclick="this.closest('.cf-row').remove()"><svg class="icon"><use href="#i-trash"></use></svg></button>
            </div>
        </div>
        <button type="button" class="btn btn-secondary btn-sm" onclick="addCustomFieldRow()"><svg class="icon" style="width:15px;height:15px"><use href="#i-plus"></use></svg> @L.T("Add requirement")</button>
    </div>

    <div class="sticky-formbar">
        <a class="btn btn-ghost" href="/Tenders">@L.T("Cancel")</a>
        <div class="form-actions-group">
            <button type="submit" asp-page-handler="Draft" class="btn btn-secondary">@L.T("Save as draft")</button>
            <button type="submit" asp-page-handler="Publish" class="btn btn-primary">@L.T("Publish tender")</button>
        </div>
    </div>
</form>
